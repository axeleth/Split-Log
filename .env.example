# Split Log — template for .env. Copy to `.env` and fill in.
#   cp .env.example .env
#
# .env is gitignored; this file is committed, so never put a real value here.

# --- Deploy target (read by deploy.sh) ---------------------------------------
# Required. deploy.sh refuses to run without these rather than falling back to
# a default that would point at someone else's server.
SPLITLOG_SERVER=root@your.server.ip
SPLITLOG_HOST=splitlog.example.com

# Optional. SPLITLOG_SERVER_IP defaults to the part after @ in SPLITLOG_SERVER,
# so set it only when the ssh target is a hostname rather than an IP. It is used
# to pin curl to the box when checking the live site.
#SPLITLOG_SERVER_IP=203.0.113.10

# Optional. Where the site lives on the server.
#SPLITLOG_WEBROOT=/var/www/splitlog

# --- Site password ------------------------------------------------------------
# The password for the Caddy cookie gate, generated by `./deploy.sh provision`.
# Nothing reads this at runtime: the site is static and Caddy enforces the gate
# server-side, so this is a convenience record, not configuration. Editing it
# does NOT rotate anything.
#
# Authoritative copy: the @authed header_regexp matcher in the server's
# /etc/caddy/Caddyfile. To rotate, edit it there, `systemctl reload caddy`,
# then update your local .env to match.
SPLITLOG_PASSWORD=
